{
  "name": "Cadence",
  "short_name": "Cadence",
  "description": "Apple-grade daily checklist & cadence manager",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen"],
  "orientation": "portrait-primary",
  "theme_color": "#F2F2F7",
